# 복사해서 .env 로 저장한 뒤 값을 채우세요 (cp .env.example .env). .env 는 커밋·공유하지 않습니다.

# Neon 읽기 전용 접속 주소 (agent_reader 역할). 관리자에게 받으세요. docs/DB_READONLY.md 참고
DATABASE_URL=

# Upstage Console(console.upstage.ai) API 키
UPSTAGE_API_KEY=
# 사용할 모델 (solar-pro 또는 solar-mini)
SOLAR_MODEL=solar-pro

# 출력 모드 기본값: expert | guide
AGENT_MODE=expert
